# @rep/mobile — copy to .env and fill in
# Schema of record: src/env.ts
#
# NOTE: EXPO_PUBLIC_* values are inlined into the app bundle at build time.
# Never put a secret here — only publishable/client-side keys.

# Base URL of the @rep/api service (no trailing slash). A simulator can use
# localhost; a physical device needs your machine's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:4100

# --- Google sign-in ---
# Optional. OAuth client IDs from the Google Cloud Console, in the form
# <id>.apps.googleusercontent.com. Set both to show Google sign-in. The iOS
# ID also goes into the iOS build as a URL scheme, so rebuild after a change.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
