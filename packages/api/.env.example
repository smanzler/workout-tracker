# @rep/api — copy to .env and fill in
# Schema of record: src/env.ts

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL the API is reachable at
BETTER_AUTH_URL=http://localhost:4100

# --- Database ---
# Matches the credentials created by docker/postgres/init.sql
DATABASE_URL=postgresql://rep:rep@localhost:5433/rep

# --- Server ---
# Optional, defaults to 4100
PORT=4100

# --- Object storage (S3-compatible, used for avatars) ---
# Defaults target the S3 mock container from docker/docker-compose.yml.
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=test
BUCKET_SECRET_KEY=test
BUCKET_NAME=rep-local
# Public base URL objects are served from, no trailing slash
BUCKET_URL=http://localhost:9091/rep-local
# S3 API endpoint. Unset for AWS itself; every other service needs it.
BUCKET_ENDPOINT=http://localhost:9091

# --- Email / SMTP (email OTP delivery) ---
# Defaults target the mailpit container from docker/docker-compose.yml.
# Leave these unset for local dev; inbox UI is at http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
# "true" or "false"
SMTP_SECURE=false
# Optional; auth is only sent when BOTH user and password are set
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Rep <noreply@rep.local>

# --- Push notifications (Expo) ---
# Optional. Only needed when the Expo project requires an access token for
# sending; unset works for unauthenticated sends.
EXPO_ACCESS_TOKEN=

# --- Google sign-in ---
# Optional. The web OAuth client from the Google Cloud Console, not the
# app's EXPO_PUBLIC_GOOGLE_* client IDs. Set both to turn Google on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple ---
# Optional. Set all five to turn Apple on.
# The Services ID, not the app's bundle ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
# The key ID of the .p8 Sign in with Apple key.
APPLE_KEY_ID=
# The .p8 key as PKCS#8 PEM on one line, in double quotes with \n, e.g.:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n"
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=com.sigh10.workouttracker

# --- Store review account ---
# Optional. When BOTH are set, signing in as REVIEW_EMAIL accepts REVIEW_OTP
# (6 digits) and sends no email. Unset either one to disable the account.
REVIEW_EMAIL=
REVIEW_OTP=
