{
  "name": "@rep/api",
  "private": true,
  "type": "module",
  "types": "src/types.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/expo": "^1.7.7",
    "@rep/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.8.5",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "pg-boss": "^12.37.0",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
